__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Test fixtures are downloaded, never committed
tests/_data/

# Stores and corpora are built, never committed. Neither is redistributed.
*.db
*.sqlite
*.npz
*.h5ad

# HEAD.txt: the commit a compute node records, regenerated by every pull and never edited.
# It is untracked BY DESIGN — it names the checkout, not the code — and the site compliance
# check that demands both `HEAD.txt == git rev-parse HEAD` AND a clean `git status --porcelain`
# could not pass in any repository while it was also the porcelain output. Ignored here so the
# two halves of that check can both be true. Nothing in this tool reads .gitignore.
HEAD.txt
.mpl/
